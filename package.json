{
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compile": "graphql-codegen --require dotenv/config",
    "watch": "graphql-codegen --require dotenv/config -w",
    "generate": "drizzle-kit generate",
    "up": "drizzle-kit up",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply db-tarheel-compass --local",
    "db:migrate:preview": "wrangler d1 migrations apply --env preview preview-db-tarheel-compass --remote",
    "db:migrate:prod": "wrangler d1 migrations apply db-tarheel-compass --remote",
    "db:studio:local": "cross-env DB_LOCAL_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:preview": "cross-env NODE_ENV='preview' drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "pages:build": "pnpm next-on-pages",
    "pages:dev": "pnpm pages:build && pnpm wrangler pages dev",
    "pages:deploy": "pnpm pages:build && pnpm wrangler pages deploy"
  },
  "dependencies": {
